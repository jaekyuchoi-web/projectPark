# 이 파일을 복사하여 secret.env 로 저장한 뒤 실제 값을 채워주세요.
#   cp secret.env.example secret.env
# secret.env 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.
# 키 값은 화면/로그에 절대 노출되지 않습니다.

# OpenAI API 키 (사업자명 정규화에 사용)
OPENAI_API_KEY=sk-proj-여기에_본인_키를_입력하세요

# 사용할 모델 (기본값: gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini

# Cloud Run 배포 시 deploy.sh 가 자동 설정 (web.app API 직접 호출용). 로컬은 비워 둠.
# PUBLIC_API_URL=
